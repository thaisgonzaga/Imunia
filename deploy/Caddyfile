{
	frankenphp {
		# 512 MB de memória no plano gratuito: poucos PHP ao mesmo tempo.
		num_threads 4
	}
	# O Render termina o HTTPS na borda e entrega HTTP simples na porta $PORT.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# O que só o Laravel responde. `*.php` entra aqui para que nenhum arquivo
	# PHP seja servido como texto pelo bloco das telas.
	@laravel path /api/* /sanctum/* /up *.php
	handle @laravel {
		php_server
	}

	# As telas (SPA): arquivo que existe sai como está; qualquer outra rota é
	# do Vue Router e recebe o index.html.
	handle {
		# Os arquivos de build levam o hash no nome: podem ficar em cache
		# para sempre. O resto é revalidado, para que o navegador não guarde
		# um index.html que aponte para arquivos de um deploy anterior.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@paginas not path /assets/*
		header @paginas Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
