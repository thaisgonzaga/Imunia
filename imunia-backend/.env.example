APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Endereço do SPA: usado nas ligações enviadas por e-mail (redefinição de senha,
# confirmação de endereço e convite de ativação).
FRONTEND_URL=http://localhost:5173

# Origens que o Sanctum trata como "mesma origem" no modo SPA.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# O servidor do Vite roda no host, e não dentro do contêiner: o Sail deixa de
# reservar a 5173 para que o `npm run dev` possa usá-la.
VITE_PORT=5273

# Produção (Render) — ver deploy/LEIAME.md na raiz do repositório.
# E-mail pela API do Brevo (MAIL_MAILER=brevo), já que o Render gratuito
# bloqueia SMTP; fotos, anexos e PDFs no bucket S3 (Backblaze B2) em vez do
# disco do contêiner, que é apagado a cada deploy; e o endereço da conta que
# administra o catálogo de vacinas, garantida por `imunia:preparar`.
BREVO_API_KEY=
ARQUIVOS_NA_NUVEM=false
ADMIN_PLATAFORMA_EMAIL=
